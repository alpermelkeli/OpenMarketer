# OpenMarketer - example environment file
#
#   cp .env.example .env      then fill in the values you need
#
# Never commit .env. Leave a value empty to disable that integration.
# Everything here has a safe default; start in dry-run mode (DRY_RUN=true).

# =====================================================================
# 1. LLM access through OpenRouter (default provider)
# =====================================================================
# Create a key at https://openrouter.ai/keys. One key reaches many model providers.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution shown on OpenRouter dashboards
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=OpenMarketer

# Path to the per-role model configuration (see config/models.yaml)
LLM_CONFIG_PATH=config/models.yaml

# Monthly LLM spend cap in USD, enforced by the budget ledger
LLM_MONTHLY_CAP_USD=50

# --- change models without editing any file ---------------------------
# Tier overrides: every role that uses the tier follows.
# Model slugs use OpenRouter's "provider/model" form (check https://openrouter.ai/models).
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_STRONG=

# Per-role overrides (highest priority). Role name in upper case.
# Roles: ORCHESTRATOR, REPO_ANALYZER, RESEARCHER, READER, PLANNER, WRITER,
#        REPLY_DRAFTER, CREATIVE_DIRECTOR, STUDIO, ASSET_VERIFIER, CRITIC, ANALYST,
#        VISION, JUDGE, EMBEDDINGS
# LLM_MODEL__ORCHESTRATOR=
# LLM_MODEL__WRITER=
# LLM_MODEL__READER=

# =====================================================================
# 2. Media providers
# =====================================================================
# Images: fal.ai
FAL_KEY=
# Video: Higgsfield (confirm API access and the exact credential scheme first)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Voice: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Monthly cap for generated media in USD (images, video, voice)
MEDIA_MONTHLY_CAP_USD=60

# --- Creative studio (agentic image, video and voice production) ---------
# Maximum produce -> verify -> edit rounds per asset before escalating to a human
STUDIO_MAX_ITERATIONS=4
# Cost cap per finished asset in USD (generation and LLM calls together)
STUDIO_MAX_COST_PER_ASSET_USD=1.00
# Where agent-written code runs: docker | none (none disables code composition)
STUDIO_SANDBOX=docker
STUDIO_SANDBOX_IMAGE=openmarketer/studio-sandbox:latest
STUDIO_SANDBOX_TIMEOUT_S=60
STUDIO_SANDBOX_MEMORY_MB=1024
STUDIO_SANDBOX_CPUS=1
# The sandbox has no network access. Generation APIs are called by the worker, not by agent code.

# =====================================================================
# 3. Application core
# =====================================================================
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Generate with: openssl rand -hex 32
SECRET_KEY=
# 32-byte key (base64) used for envelope encryption of platform tokens
ENCRYPTION_KEY=

DATABASE_URL=postgresql+psycopg://openmarketer:change-me@postgres:5432/openmarketer
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Object storage (any S3-compatible service; MinIO in the default compose file)
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=openmarketer-assets
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# =====================================================================
# 4. Safety defaults (new projects start here)
# =====================================================================
# true = the agent drafts and proposes, nothing is published or spent
DRY_RUN=true
# 0 suggest only, 1 approve everything, 2 automatic for low risk, 3 capped autonomy
DEFAULT_AUTONOMY_LEVEL=0
# true = block all outgoing actions immediately
KILL_SWITCH=false
# Hours to wait for a human decision before an approval request counts as rejected
APPROVAL_TIMEOUT_HOURS=48
# Orchestrator chat: allow it to execute safe-direction actions (pause campaign, enable kill switch)
CHAT_ALLOW_SAFE_ACTIONS=true

# =====================================================================
# 4b. Proactive mode (the orchestrator speaks first)
# =====================================================================
PROACTIVE_ENABLED=true
# off | daily | weekly
DIGEST_FREQUENCY=weekly
# Local time for digests, and the timezone used for quiet hours
DIGEST_TIME=09:00
PROACTIVE_TIMEZONE=UTC
# No non-urgent notifications between these local times
QUIET_HOURS=22:00-08:00
# Remind about pending approvals after this many hours, escalate after the second value
APPROVAL_REMINDER_AFTER_HOURS=24
APPROVAL_ESCALATE_AFTER_HOURS=36
# Upper limit of proactive notifications per project per day (urgent ones excluded)
MAX_NOTIFICATIONS_PER_DAY=6
# Which events the watchdog reports (comma separated)
ALERT_EVENTS=spend_anomaly,negative_spike,policy_violation,platform_warning,connector_failure
# Let the watchdog apply safe-direction brakes (pause campaigns, lower caps) before notifying
WATCHDOG_AUTO_BRAKE=true

# =====================================================================
# 5. Login (OIDC). Leave empty for single-user local mode.
# =====================================================================
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# =====================================================================
# 6. Notifications (Apprise URLs, comma separated)
# =====================================================================
# Examples: tgram://BOT_TOKEN/CHAT_ID , slack://TOKEN_A/TOKEN_B/TOKEN_C , mailto://user:pass@gmail.com
APPRISE_URLS=

# =====================================================================
# 7. Platform developer apps (bring your own; one set per installation)
# =====================================================================
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# =====================================================================
# 8. Source code access (read-only)
# =====================================================================
# Fine-grained token with read-only repository contents access
GITHUB_TOKEN=
GITLAB_TOKEN=

# =====================================================================
# 9. Observability (optional)
# =====================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
