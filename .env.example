# OpenMarketer - example environment file
#
#   cp .env.example .env      then fill in the values you need
#
# Never commit .env. Leave a value empty to disable that integration.
# Everything here has a safe default; start in dry-run mode (DRY_RUN=true).

# =====================================================================
# 1. LLM access through OpenRouter (default provider)
# =====================================================================
# Create a key at https://openrouter.ai/keys. One key reaches many model providers.
# For the worker it can be stored in the dashboard instead (Settings, Credentials; needs
# ENCRYPTION_KEY below). A value here takes precedence over a stored one. The command
# line (make analyze, make evaluate) reads only this variable.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter's decisions endpoint (alpha), for roles of kind decisions (config/models.yaml)
OPENROUTER_DECISIONS_URL=https://openrouter.ai/api/alpha/decisions
# Optional attribution shown on OpenRouter dashboards
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=OpenMarketer

# Path to the per-role model configuration (see config/models.yaml)
LLM_CONFIG_PATH=config/models.yaml

# Monthly LLM spend cap in USD, enforced by the budget ledger
LLM_MONTHLY_CAP_USD=50

# --- change models without editing any file ---------------------------
# For the worker, models can also be chosen in the dashboard (Settings, Models). A variable
# here wins over a choice made there; the command line reads only these variables.
# Tier overrides: every role that uses the tier follows.
# Model slugs use OpenRouter's "provider/model" form (check https://openrouter.ai/models).
LLM_MODEL_FAST=
LLM_MODEL_BALANCED=
LLM_MODEL_STRONG=

# Per-role overrides (highest priority). Role name in upper case.
# Roles: ORCHESTRATOR, REPO_ANALYZER, RESEARCHER, READER, PLANNER, WRITER,
#        REPLY_DRAFTER, CREATIVE_DIRECTOR, STUDIO, ASSET_VERIFIER, CRITIC, ANALYST,
#        VISION, JUDGE, EMBEDDINGS
# LLM_MODEL__ORCHESTRATOR=
# LLM_MODEL__WRITER=
# LLM_MODEL__READER=

# =====================================================================
# 2. Media providers
# =====================================================================
# Images: fal.ai
FAL_KEY=
# Video: Higgsfield (confirm API access and the exact credential scheme first)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Voice: ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=

# Monthly cap for generated media in USD (images, video, voice)
MEDIA_MONTHLY_CAP_USD=60

# --- Creative studio (agentic image, video and voice production) ---------
# Maximum produce -> verify -> edit rounds per asset before escalating to a human
STUDIO_MAX_ITERATIONS=4
# Cost cap per finished asset in USD (generation and LLM calls together)
STUDIO_MAX_COST_PER_ASSET_USD=1.00
# Where agent-written code runs: docker | none (none disables code composition)
STUDIO_SANDBOX=docker
STUDIO_SANDBOX_IMAGE=openmarketer/studio-sandbox:latest
STUDIO_SANDBOX_TIMEOUT_S=60
STUDIO_SANDBOX_MEMORY_MB=1024
STUDIO_SANDBOX_CPUS=1
# The sandbox has no network access. Generation APIs are called by the worker, not by agent code.

# =====================================================================
# 3. Application core
# =====================================================================
APP_ENV=development
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000

# Generate with: openssl rand -hex 32
SECRET_KEY=
# The key that credentials stored from the dashboard (Settings, Credentials) are encrypted
# with: the OpenRouter API key, the GitHub token and the GitLab token. 32 random bytes in
# base64; generate one with: openssl rand -base64 32
# The API encrypts with it and the worker decrypts with it, so both need the SAME value.
# Empty: nothing can be stored, and credentials come from this file only. There is no key
# rotation: after changing it, every stored credential has to be set again.
ENCRYPTION_KEY=

DATABASE_URL=postgresql+psycopg://openmarketer:change-me@postgres:5432/openmarketer
# Host names here are those of the compose network. For `make worker` on the host,
# against the dev stack, use localhost:7233 (the worker's default when this is empty).
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default

# Repository analysis in the worker. An attempt continues from the checkpoints of the one
# before it (kept in DATABASE_URL until the run ends), on the commit the run first cloned,
# so the model budget holds for the whole run. Minutes one attempt at a graph step may take,
# and how many attempts each step gets (1 = never retried); the clone has fixed limits of
# its own.
ANALYSIS_TIMEOUT_MINUTES=30
ANALYSIS_MAX_ATTEMPTS=5
# Activities one worker process runs at a time; an analysis is one of them
WORKER_MAX_CONCURRENT_ACTIVITIES=4

# Research runs in the worker. Minutes one attempt at a graph step may take, and how many
# attempts each step gets (1 = never retried). The search and the rendering of pages are
# the free, self-hosted services of the dev stack (SearXNG and Lightpanda; `make up`);
# the defaults below are their published ports, for `make worker` on the host.
RESEARCH_TIMEOUT_MINUTES=30
RESEARCH_MAX_ATTEMPTS=5
# How long the pages a research run fetched stay in object storage before the worker
# removes them; a report keeps only the quotes it relied on.
RESEARCH_PAGE_RETENTION_DAYS=30
SEARXNG_URL=http://localhost:8888
LIGHTPANDA_URL=http://localhost:9222

# Object storage (any S3-compatible service; MinIO in the default compose file). The pages
# the researcher fetched are kept here until they expire. Host names here are those of the
# compose network; for `make worker` on the host, against the dev stack, use
# http://localhost:9000 (the worker's default when this is empty).
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=openmarketer-assets
S3_ACCESS_KEY=openmarketer
S3_SECRET_KEY=openmarketer-dev
S3_REGION=us-east-1

# =====================================================================
# 4. Safety defaults (new projects start here)
# =====================================================================
# true = the agent drafts and proposes, nothing is published or spent
DRY_RUN=true
# 0 suggest only, 1 approve everything, 2 automatic for low risk, 3 capped autonomy
DEFAULT_AUTONOMY_LEVEL=0
# true = block all outgoing actions immediately
KILL_SWITCH=false
# Hours to wait for a human decision before an approval request counts as rejected
APPROVAL_TIMEOUT_HOURS=48
# Orchestrator chat: allow it to execute safe-direction actions (pause campaign, enable kill switch)
CHAT_ALLOW_SAFE_ACTIONS=true

# =====================================================================
# 4b. Proactive mode (the orchestrator speaks first)
# =====================================================================
PROACTIVE_ENABLED=true
# off | daily | weekly
DIGEST_FREQUENCY=weekly
# Local time for digests, and the timezone used for quiet hours
DIGEST_TIME=09:00
PROACTIVE_TIMEZONE=UTC
# No non-urgent notifications between these local times
QUIET_HOURS=22:00-08:00
# Remind about pending approvals after this many hours, escalate after the second value
APPROVAL_REMINDER_AFTER_HOURS=24
APPROVAL_ESCALATE_AFTER_HOURS=36
# Upper limit of proactive notifications per project per day (urgent ones excluded)
MAX_NOTIFICATIONS_PER_DAY=6
# Which events the watchdog reports (comma separated)
ALERT_EVENTS=spend_anomaly,negative_spike,policy_violation,platform_warning,connector_failure
# Let the watchdog apply safe-direction brakes (pause campaigns, lower caps) before notifying
WATCHDOG_AUTO_BRAKE=true

# =====================================================================
# 5. Login (OIDC). Leave empty for single-user local mode.
# =====================================================================
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# =====================================================================
# 6. Notifications (Apprise URLs, comma separated)
# =====================================================================
# Examples: tgram://BOT_TOKEN/CHAT_ID , slack://TOKEN_A/TOKEN_B/TOKEN_C , mailto://user:pass@gmail.com
APPRISE_URLS=

# =====================================================================
# 7. Platform developer apps (bring your own; one set per installation)
# =====================================================================
META_APP_ID=
META_APP_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=

# =====================================================================
# 8. Source code access (read-only)
# =====================================================================
# Fine-grained tokens with read-only repository contents access. A token is sent only
# to the host it belongs to; a repository on any other host is cloned without credentials.
# For the worker, either token can be stored in the dashboard instead (Settings, Credentials;
# needs ENCRYPTION_KEY). A value here takes precedence over a stored one. The command line
# reads only these variables. GITLAB_HOST can be set only here.
# GITHUB_TOKEN is sent to github.com only.
GITHUB_TOKEN=
# GITLAB_TOKEN is sent to gitlab.com only, or to GITLAB_HOST when that is set:
# the host name of a self-hosted GitLab (gitlab.example.com, or gitlab.example.com:8443).
GITLAB_TOKEN=
GITLAB_HOST=
# git is run with a reduced environment when it clones a repository. Of the variables of
# the process it sees only PATH, TMPDIR and, if you set them, the ones below; an
# installation behind a proxy or with its own certificate authority needs them.
# Nothing here or elsewhere switches certificate verification off.
# HTTPS_PROXY=
# NO_PROXY=
# GIT_SSL_CAINFO=        (also read: GIT_SSL_CAPATH, SSL_CERT_FILE, SSL_CERT_DIR, CURL_CA_BUNDLE)

# =====================================================================
# 9. Observability (optional)
# =====================================================================
# Langfuse tracing of agent runs (the worker and the command line): every node of a graph
# with the state it read and changed, and every model call with its messages, reply, tokens
# and cost. Off unless both keys are set. When on, prompts and replies, which hold repository
# content (with the secrets intake found blanked out), are sent to Langfuse Cloud, or to
# LANGFUSE_BASE_URL for a self-hosted Langfuse. The model provider's key is never sent.
# The worker and the command line refuse to start with one key and not the other.
# The dev stack has a Langfuse of its own (`make up tracing=1`, http://localhost:3001, sign
# in as dev@openmarketer.local / openmarketer-dev), whose project has these keys:
#   LANGFUSE_PUBLIC_KEY=pk-lf-openmarketer-dev
#   LANGFUSE_SECRET_KEY=sk-lf-openmarketer-dev
#   LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Not read yet: standard OpenTelemetry traces of the rest of the system.
OTEL_EXPORTER_OTLP_ENDPOINT=
